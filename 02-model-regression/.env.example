# copy to .env — never commit .env
REG_LLM_BASE_URL=http://127.0.0.1:8081/v1      # any OpenAI-compatible endpoint; default = local mlx_lm server
REG_LLM_API_KEY=local-no-key
REG_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
REG_JUDGE_MODEL=                               # empty = same model as the feature under test
REG_WARN_DELTA=0.03                            # policy thresholds (pass-rate drop, fraction)
REG_CRITICAL_DELTA=0.08
REG_SUMMARY_PASS_SCORE=4
REG_DRIFT_WINDOW=7
REG_DRIFT_THRESHOLD=0.85
REG_SLACK_WEBHOOK_URL=                         # leave empty until a TEST channel webhook is authorised
REG_REPORT_BASE_URL=                           # where HTML reports are published (for the Slack link)
