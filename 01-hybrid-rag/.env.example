# Copy to .env (never commit .env). All values are optional; defaults run fully local.

# LLM endpoint (OpenAI-compatible). Default = local mlx_lm server started by scripts/serve_llm.sh
RAG_LLM_BASE_URL=http://127.0.0.1:8081/v1
RAG_LLM_API_KEY=local-no-key
RAG_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# To use OpenAI instead (paid, needs your own key — not enabled by default):
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_API_KEY=sk-...
# RAG_LLM_MODEL=gpt-4o-mini

# Local models (downloaded from Hugging Face on first use)
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval knobs
RAG_DEFAULT_STRATEGY=recursive
RAG_RRF_DENSE_WEIGHT=0.7
RAG_RRF_SPARSE_WEIGHT=0.3
RAG_RETRIEVAL_CONFIDENCE_THRESHOLD=0.40
