# /etc/agentops.env on the server (root-only). Model calls go to Bedrock via the 'bedrock' AWS profile in /home/ubuntu/.aws.
AO_LLM_PROVIDER=bedrock
AO_BEDROCK_REGION=us-east-1
AO_BEDROCK_PROFILE=bedrock
AO_LLM_MODEL=amazon.nova-lite-v1:0
AO_PRICE_IN_PER_1K=0.00006
AO_PRICE_OUT_PER_1K=0.00024
AO_APP_ALLOWANCE_USD=5.00
AO_MAX_COST_USD=0.25
AO_MAX_WALL_SECONDS=600
AO_MAX_CONCURRENCY=1
AO_WEB_SEARCH_LIVE=false
AO_HTTP_POST_ALLOWLIST=["http://127.0.0.1:8099"]
AO_DOCS_CORPUS_PATH=/opt/agentops/01-hybrid-rag/data/processed/docs.jsonl
