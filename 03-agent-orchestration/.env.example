# copy to .env — never commit .env
AO_LLM_BASE_URL=http://127.0.0.1:8081/v1          # any OpenAI-compatible endpoint (local mlx_lm server by default)
AO_LLM_API_KEY=local-no-key
AO_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
AO_REVIEWER_MODEL=                                 # empty = same model
AO_PRICE_IN_PER_1K=0                               # USD per 1k prompt tokens (ledger); set for a paid model
AO_PRICE_OUT_PER_1K=0
# budgets (per run) — enforced in code
AO_MAX_STEPS=40
AO_MAX_LLM_CALLS=30
AO_MAX_TOOL_CALLS=25
AO_MAX_TOKENS_TOTAL=60000
AO_MAX_WALL_SECONDS=1800
AO_MAX_RETRIES_PER_TASK=2
AO_MAX_REVIEW_ROUNDS=2
AO_MAX_CONCURRENCY=2
AO_MAX_COST_USD=0.50
AO_APP_ALLOWANCE_USD=5.00                          # whole-app cap; model calls are refused once committed spend reaches it
# human-in-the-loop
AO_PLAN_CONFIDENCE_THRESHOLD=0.6
AO_ALWAYS_APPROVE_PLAN=false
# tools
AO_WEB_SEARCH_LIVE=false                           # true = DuckDuckGo; false = offline fixture
AO_HTTP_POST_ALLOWLIST=["http://127.0.0.1:8099"]   # external writes only to the local test target unless you authorise a real destination
AO_TEST_TARGET_PORT=8099
AO_API_PORT=8010
